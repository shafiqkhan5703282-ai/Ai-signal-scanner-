 <div class="hero center"><div class="label">Current balance</div><div class="amount" id="balance2">0.00<span class="unit">USDT</span></div>
 <div class="buttons"><button class="btn primary" id="topup2">＋ Top up</button><button class="btn secondary off" id="withdraw2">↑ Withdraw</button></div></div>
 <div class="content"><div class="grid">
  <div class="card"><h3>Deposit</h3><div class="big" id="deposit">0.00</div><p class="muted">USDT</p></div>
  <div class="card"><h3>Withdraw</h3><div class="big" id="withdrawn">0.00</div><p class="muted">USDT</p></div>
  <div class="card"><h3>Referral</h3><div class="big" id="ref2">0.00</div><p class="muted">USDT</p></div>
 </div></div>
</section>

<section class="page" id="trading">
 <div class="content"><div class="row"><div class="status"><span class="dot" id="dot2"></span>Bot status: <b id="status2">Inactive</b></div><div class="price" id="price2">$85,372.42</div></div>
 <div class="buttons"><button class="btn primary" id="start2">🚀 Start</button><button class="btn danger off" id="stop2">✕ Stop</button></div>
 <div class="box" style="margin-top:18px"><canvas id="chart2"></canvas></div>
 <h2 style="text-align:center">Trading bot statistics</h2>
 <div class="tabs"><button class="tab active">24h</button><button class="tab">7d</button><button class="tab">1m</button><button class="tab">3m</button></div>
 <div class="box"><div class="row"><span>🚀 Total deals</span><b id="td">45</b></div><div class="row"><span>✓ Successful</span><b id="succ">41</b></div><div class="row"><span>↘ Failed</span><b>4</b></div><div class="row"><span>Profit</span><b id="ps">+8.22%</b></div></div>
 </div>
</section>

<section class="page" id="support"><div class="content"><div class="list">
 <button id="chatBtn">💬 Support Chat <span style="float:right">›</span></button>
 <details><summary>? FAQ</summary><p>This is a front-end demo. Buttons and local wallet functions work in the browser. No real trades are placed.</p></details>
