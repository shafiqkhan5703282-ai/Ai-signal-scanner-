<title>NOVA AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#05060a;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Arial,sans-serif}
button{border:0;font:inherit;cursor:pointer;-webkit-appearance:none}
.app{max-width:900px;min-height:100vh;margin:auto;background:#080a10;padding-bottom:105px}
.header{padding:16px 18px 8px;position:sticky;top:0;z-index:10;background:#080a10}
.top{height:42px;display:flex;align-items:center;justify-content:space-between}
.close{background:none;color:#fff;font-size:18px}
.brand{text-align:center}.brand b{font-size:21px}.brand small{display:block;color:#9298a8;font-size:13px}
.more{background:#151822;color:#fff;border-radius:50%;width:40px;height:40px;font-size:20px}
.head{display:flex;align-items:center;margin-top:18px}.back{background:none;color:#fff;font-size:38px;width:50px}.title{flex:1;text-align:center;font-size:27px;font-weight:650}
.page{display:none}.page.active{display:block}
.hero{margin:8px 14px 18px;padding:28px 20px;border-radius:34px;background:linear-gradient(145deg,#39247c,#17132e);border:1px solid #533ba0}
.center{text-align:center}.label{font-size:22px;font-weight:650}.amount{font-size:70px;font-weight:750;letter-spacing:-3px;margin:12px 0}.unit{font-size:17px;letter-spacing:0;vertical-align:top;margin-left:5px}
.buttons{display:flex;gap:12px;margin-top:22px}.btn{height:62px;flex:1;border-radius:32px;font-size:19px;font-weight:650}.primary{background:#875cff;color:#fff}.secondary{background:#39344b;color:#ddd}.danger{background:#39151e;color:#ff6377}.off{opacity:.35}
.content{padding:0 18px}.box{background:#10131b;border-radius:25px;padding:18px;border:1px solid #1d2130;margin-bottom:15px}
canvas{display:block;width:100%;height:230px}
.row{display:flex;justify-content:space-between;align-items:center;margin:18px 3px}.withdrawBox{margin-top:12px}.withdrawBox label{display:block;color:#aeb4c2;font-size:16px;margin:0 0 8px}.feeLine{display:flex;justify-content:space-between;gap:14px;color:#d9dce5;font-size:16px;margin:12px 2px}.feeLine b{color:#6F8CFF;text-align:right}.withdrawBox .input{margin-bottom:10px}.status{font-size:17px}.dot{display:inline-block;width:11px;height:11px;border-radius:50%;background:#777;margin-right:8px}.dot.on{background:#6F8CFF;box-shadow:0 0 12px #6F8CFF}.price{font-weight:700;color:#ad98ff;font-size:20px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{background:#111426;border-radius:20px;padding:18px 14px;min-height:125px}.card h3{margin:0 0 10px}.big{font-size:23px;color:#a88cff;font-weight:700}.muted{color:#8d94a7;font-size:14px}
.list{display:grid;gap:12px}.list button,.list details{background:#111426;color:#fff;border-radius:20px;padding:21px;text-align:left;font-size:18px}.list summary{cursor:pointer}.list p{color:#9298a8;line-height:1.5;font-size:15px}
.tabs{display:flex;gap:9px;margin:15px 0}.tab{flex:1;padding:14px 5px;border-radius:25px;background:#111426;color:#aaa}.tab.active{background:#2c205e;color:#bdaeff}
.nav{position:fixed;z-index:30;bottom:12px;left:50%;transform:translateX(-50%);width:min(850px,calc(100% - 24px));height:76px;border-radius:40px;background:#10191a;display:flex;align-items:center;justify-content:space-around;border:1px solid #1d2929;box-shadow:0 10px 50px #000}.nav button{width:58px;height:58px;border-radius:50%;background:none;color:#eee;font-size:28px}.nav button.active{background:#875cff}
.modal{display:none;position:fixed;z-index:50;inset:0;background:rgba(0,0,0,.75);align-items:flex-end}.modal.show{display:flex}.sheet{width:100%;max-width:650px;margin:auto;background:#111426;border-radius:28px 28px 0 0;padding:25px 20px 30px}.sheet h2{margin:0 0 8px}.sheet p{color:#999fb0}.input{width:100%;height:56px;background:#080a10;border:1px solid #292e3c;color:#fff;border-radius:15px;padding:0 15px;margin:10px 0 15px;font-size:17px}.sheet .btn{width:100%;display:block}.cancel{width:100%;height:52px;border-radius:15px;background:#272c38;color:#fff;margin-top:10px}
.toast{position:fixed;z-index:100;left:50%;bottom:105px;transform:translate(-50%,20px);opacity:0;background:#fff;color:#080a10;padding:13px 18px;border-radius:15px;font-weight:650;transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:600px){.grid{grid-template-columns:1fr 1fr}.card:last-child{grid-column:1/-1}.amount{font-size:64px}}

/* Alternate visual theme — layout/functionality intentionally unchanged */
body{background:#070817!important;color:#F4F5FF!important}
.app{background:linear-gradient(180deg,#0A0B1B 0%,#080914 100%)!important}
.header{background:rgba(10,11,27,.92)!important}
.hero{background:linear-gradient(145deg,#171A3B 0%,#24205A 48%,#12152F 100%)!important;
      border:1px solid rgba(124,92,255,.35)!important;
      box-shadow:0 18px 60px rgba(71,52,180,.22)!important}
.btn.primary{background:linear-gradient(135deg,#7C5CFF,#4C7DFF)!important;color:#fff!important}
.btn.secondary{background:#202543!important;color:#B9C4FF!important}
.btn.danger{background:#32172A!important;color:#FF8FB7!important}
.card,.box,.list button,.list details,.sheet{background:#111426!important;border:1px solid rgba(124,92,255,.13)!important}
.nav{background:rgba(13,15,32,.96)!important;border-color:rgba(124,92,255,.16)!important}
.nav button.active{background:linear-gradient(135deg,#7C5CFF,#4C7DFF)!important;color:#fff!important}
.input{background:#0C0F20!important;color:#fff!important;border-color:#2A2E50!important}
.toast{background:#181B36!important;color:#fff!important;border:1px solid rgba(124,92,255,.35)!important}
.price,.big,.amount{color:#7C5CFF!important}
.dot{background:#7C5CFF!important;box-shadow:0 0 16px rgba(124,92,255,.7)!important}

.qr{display:block;width:230px;height:230px;margin:18px auto;border-radius:12px;background:#0C0F20;padding:10px}.addressBox{background:#0C0F20;border:1px solid #2A2E50;border-radius:15px;padding:16px;font-size:15px;line-height:1.45;word-break:break-all;margin:10px 0 14px;color:#fff}.sheet .btn{margin-top:8px}
</style>
</head>
<body>
<div class="app">
<header class="header">
 <div class="top">
  <button class="close" id="closeBtn">Close</button>
  <div class="brand"><b>NOVA AI</b><small>mini app • DEMO</small></div>
