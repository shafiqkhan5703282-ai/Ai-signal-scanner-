</div></div></section>

<section class="page" id="settings"><div class="content"><div class="list">
 <button id="pushBtn">🔔 Push notifications <span id="pushState" style="float:right">●</span></button>
 <button id="vibBtn">📳 Vibration <span id="vibState" style="float:right">○</span></button>
 <button id="chat2">💬 Support Chat <span style="float:right">›</span></button>
 <button id="faqBtn">? FAQ <span style="float:right">›</span></button>
 <button id="refBtn">🔗 Referral link <span style="float:right">›</span></button>
 <button id="seedBtn">🔐 Seed code <span style="float:right">›</span></button>
</div></div></section>

<nav class="nav">
 <button class="active" data-page="home">⌂</button><button data-page="wallet">▣</button><button data-page="trading">⌁</button><button data-page="support">▢</button>
</nav>
</div>

<div class="modal" id="modal"><div class="sheet" id="sheet"></div></div>
<div class="toast" id="toast"></div>

<script>
(function(){
'use strict';
var balance=0,deposit=0,withdrawn=0,bot=false,price=85372.42,profit=0,deals=0,timer=null;
var pages={home:'NOVA AI',wallet:'Wallet',trading:'Trading',support:'Support',settings:'Settings'};
var ADDRESS='TBo2HtcHofviJb5TLKPjRBmWEf9YXCZKSp';var QR='';
function $(id){return document.getElementById(id)}
function toast(msg){var t=$('toast');if(!t)return;t.textContent=msg;t.classList.add('show');clearTimeout(window.__toast);window.__toast=setTimeout(function(){t.classList.remove('show')},2200)}
function page(p){document.querySelectorAll('.page').forEach(function(x){x.classList.remove('active')});var el=$(p);if(el)el.classList.add('active');var title=$('title');if(title)title.textContent=pages[p]||'NOVA AI';document.querySelectorAll('.nav button').forEach(function(x){x.classList.toggle('active',x.getAttribute('data-page')===p)});window.scrollTo(0,0)}
function sync(){
 var a=$('balance'),b=$('balance2');
 if(a)a.innerHTML=balance.toFixed(2)+'<span class="unit">USDT</span>';
 if(b)b.innerHTML=balance.toFixed(2)+'<span class="unit">USDT</span>';
 if($('deposit'))$('deposit').textContent=deposit.toFixed(2);
 if($('withdrawn'))$('withdrawn').textContent=withdrawn.toFixed(2);
 if($('ref'))$('ref').textContent='0.00'; if($('ref2'))$('ref2').textContent='0.00';
 ['withdraw1','withdraw2'].forEach(function(id){var e=$(id);if(e)e.classList.toggle('off',balance<=0)});
}
function closeModal(){var m=$('modal');if(m)m.classList.remove('show');if($('sheet'))$('sheet').innerHTML=''}
function openModal(type){
 var s=$('sheet'),m=$('modal'); if(!s||!m)return;
 var h='';
 if(type==='top')h='<h2>Deposit USDT</h2><p>Network: <b>TRC20</b></p><img class="qr" src="data:image/png;base64,'+QR+'" alt="TRC20 deposit QR"><div class="addressBox">'+ADDRESS+'</div><button class="btn primary" data-action="copy-address">▣ Copy Address</button><input class="input" id="depositAmount" type="number" min="1" step="0.01" placeholder="USDT amount received"><button class="btn primary" data-action="paid">✓ Paid</button><button class="cancel" data-action="cancel">Close</button>';
 if(type==='withdraw')h='<h2>Withdraw</h2><p>USDT TRC20 withdrawal. Commission: <b>3 USDT + 15% of amount</b>.</p><input class="input" id="withdrawAddress" placeholder="TRC20 wallet address"><button class="cancel" data-action="paste" style="margin-top:0">Paste address</button><input class="input" id="withdrawAmount" type="number" min="10" step="0.01" placeholder="USDT amount"><div class="feeLine"><span>Current balance</span><b>'+balance.toFixed(2)+' USDT</b></div><div class="feeLine"><span>Commission</span><b>3 USDT + 15%</b></div><p class="muted">Minimum withdrawal: 10 USDT. Total deducted = amount + commission.</p><button class="btn primary" data-action="withdraw">Continue</button><button class="cancel" data-action="cancel">Cancel</button>';
 if(type==='chat')h='<h2>Support Chat</h2><p>Send a message to support.</p><input class="input" id="message" placeholder="Your message"><button class="btn primary" data-action="send">Send</button><button class="cancel" data-action="cancel">Cancel</button>';
 if(type==='ref')h='<h2>Referral link</h2><input class="input" value="https://nova-ai.example/ref/demo123" readonly><button class="btn primary" data-action="copy-ref">Copy link</button><button class="cancel" data-action="cancel">Close</button>';
 if(type==='seed')h='<h2>Seed code</h2><p>Never enter a real wallet seed phrase into an untrusted website. This demo does not use a real seed.</p><button class="cancel" data-action="cancel">Close</button>';
 s.innerHTML=h;m.classList.add('show');
}
function copyText(text){
 if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(function(){toast('Copied')}).catch(function(){fallbackCopy(text)})}
 else fallbackCopy(text)
}
function fallbackCopy(text){var ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');toast('Copied')}catch(e){toast('Copy unavailable — press and hold to copy')}document.body.removeChild(ta)}
function validTRC20(a){return /^T[1-9A-HJ-NP-Za-km-z]{33}$/.test(a)}
function setBot(){
 ['status','status2'].forEach(function(id){if($(id))$(id).textContent=bot?'Active':'Inactive'});
 ['dot','dot2'].forEach(function(id){if($(id))$(id).classList.toggle('on',bot)});
 ['start','start2'].forEach(function(id){if($(id))$(id).classList.toggle('off',bot)});
 ['stop','stop2'].forEach(function(id){if($(id))$(id).classList.toggle('off',!bot)});
}
function startBot(){if(bot)return;bot=true;setBot();toast('Bot started — demo mode');timer=setInterval(function(){price+=(Math.random()-.45)*220;profit+=Math.random()*.16;deals++;var p='$'+price.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});if($('price'))$('price').textContent=p;if($('price2'))$('price2').textContent=p;if($('profit'))$('profit').textContent='+'+profit.toFixed(2)+'%';if($('deals'))$('deals').textContent=deals;if($('td'))$('td').textContent=45+deals;if($('succ'))$('succ').textContent=41+deals;if($('ps'))$('ps').textContent='+'+(8.22+profit).toFixed(2)+'%';draw('chart');draw('chart2')},2000)}
function stopBot(){bot=false;clearInterval(timer);timer=null;setBot();toast('Bot stopped')}
function draw(id){var c=$(id);if(!c)return;var r=c.getBoundingClientRect(),d=window.devicePixelRatio||1,w=Math.max(280,r.width),h=230;c.width=w*d;c.height=h*d;var x=c.getContext('2d');x.setTransform(d,0,0,d,0,0);x.clearRect(0,0,w,h);x.strokeStyle='#252a39';x.lineWidth=1;for(var i=0;i<6;i++){var y=15+i*38;x.beginPath();x.moveTo(12,y);x.lineTo(w-12,y);x.stroke()}var pts=[],y=h-35;for(i=0;i<38;i++){y-=Math.random()*6+1;if(i%8===0)y+=7;pts.push([12+i*(w-24)/37,y])}var mn=Math.min.apply(null,pts.map(function(p){return p[1]})),mx=Math.max.apply(null,pts.map(function(p){return p[1]}));x.beginPath();pts.forEach(function(p,j){var yy=h-25-(p[1]-mn)/(mx-mn+1)*(h-55);if(j)x.lineTo(p[0],yy);else x.moveTo(p[0],yy)});x.strokeStyle='#a080ff';x.lineWidth=4;x.lineJoin='round';x.stroke()}

document.addEventListener('click',function(e){
 var nav=e.target.closest('.nav button'); if(nav){page(nav.getAttribute('data-page'));return}
 var el=e.target.closest('[id],[data-action]'); if(!el)return; var id=el.id, action=el.getAttribute('data-action');
 if(id==='backBtn'){page('home');return} if(id==='closeBtn'){toast('NOVA AI demo');return} if(id==='moreBtn'){page('settings');return}
 if(id==='topup1'||id==='topup2'){openModal('top');return} if(id==='withdraw1'||id==='withdraw2'){if(balance>0)openModal('withdraw');else toast('Top up first');return}
 if(id==='start'||id==='start2'){startBot();return} if(id==='stop'||id==='stop2'){stopBot();return}
 if(id==='chatBtn'||id==='chat2'){openModal('chat');return} if(id==='refBtn'){openModal('ref');return} if(id==='seedBtn'){openModal('seed');return}
 if(id==='faqBtn'){toast('FAQ is shown above');return} if(id==='pushBtn'){var q=$('pushState');q.textContent=q.textContent==='●'?'○':'●';toast('Notification setting changed');return} if(id==='vibBtn'){var v=$('vibState');v.textContent=v.textContent==='●'?'○':'●';toast('Vibration setting changed');return}
 if(el.classList.contains('tab')){document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active')});el.classList.add('active');toast('Statistics period changed');return}
 if(action==='cancel'){closeModal();return}
 if(action==='copy-address'){copyText(ADDRESS);return}
 if(action==='copy-ref'){copyText('https://nova-ai.example/ref/demo123');return}
 if(action==='paste'){var inp=$('withdrawAddress');if(!inp)return;if(navigator.clipboard&&navigator.clipboard.readText){navigator.clipboard.readText().then(function(t){if(t)inp.value=t;toast(t?'Address pasted':'Clipboard is empty')}).catch(function(){toast('Paste blocked — use iPhone Paste from the keyboard')})}else toast('Use iPhone Paste from the keyboard');return}
 if(action==='paid'){var da=parseFloat($('depositAmount')&&$('depositAmount').value);if(!da||da<=0){toast('Enter deposit amount');return}balance+=da;deposit+=da;sync();closeModal();toast('Deposit added to demo balance');return}
 if(action==='withdraw'){var wa=parseFloat($('withdrawAmount')&&$('withdrawAmount').value),addr=(($('withdrawAddress')&&$('withdrawAddress').value)||'').trim();if(!validTRC20(addr)){toast('Enter a valid TRC20 address');return}if(!wa||wa<10){toast('Minimum withdrawal is 10 USDT');return}var fee=3+wa*.15,total=wa+fee;if(total>balance){toast('Insufficient balance for amount + fee');return}balance-=total;withdrawn+=wa;sync();closeModal();toast('Withdrawal recorded — fee 3 USDT + 15%');return}
 if(action==='send'){var msg=(($('message')&&$('message').value)||'').trim();if(!msg){toast('Write a message first');return}closeModal();toast('Message sent');return}
});
var modal=$('modal');if(modal)modal.addEventListener('click',function(e){if(e.target===modal)closeModal()});
window.addEventListener('resize',function(){draw('chart');draw('chart2')});
sync();setBot();draw('chart');draw('chart2');
})();
</script>
</body>
</html>
